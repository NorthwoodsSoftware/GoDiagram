<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="using:AvaloniaDemoApp.Views"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="AvaloniaDemoApp.Views.ModelJsonView">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Button Name="saveBtn"
            Content="Save"
            Grid.Column="0" Grid.Row="0"
            Margin="3"
            IsVisible="{Binding Path=CanSaveLoad, RelativeSource={RelativeSource AncestorType=views:ModelJsonView}}"
            Click="saveBtn_Click" />
    <Button Name="loadBtn"
            Content="Load"
            Grid.Column="1" Grid.Row="0"
            Margin="3"
            IsVisible="{Binding Path=CanSaveLoad, RelativeSource={RelativeSource AncestorType=views:ModelJsonView}}"
            Click="loadBtn_Click" />
    <TextBlock Name="label"
               Text="Diagram Model in JSON format:"
               Grid.Column="2" Grid.Row="0"
               VerticalAlignment="Center"
               Margin="3" />
    <TextBox Name="textBox"
             MaxHeight="300"
             ScrollViewer.VerticalScrollBarVisibility="Auto"
             Grid.Column="0" Grid.Row="1"
             Grid.ColumnSpan="3"
             Text="{Binding Path=JsonText, RelativeSource={RelativeSource AncestorType=views:ModelJsonView}}"
             IsReadOnly="{Binding Path=!CanSaveLoad, RelativeSource={RelativeSource AncestorType=views:ModelJsonView}}" />
  </Grid>
</UserControl>
