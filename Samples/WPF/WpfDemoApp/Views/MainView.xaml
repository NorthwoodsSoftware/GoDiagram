<UserControl
  x:Class="WpfDemoApp.Views.MainView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="6,4" />
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="220" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <TabControl
      Name="TabControl"
      Grid.Column="0"
      Padding="0">
      <TabItem Name="SampleTab">
        <TabItem.Header>
          <TextBlock FontSize="15" Text="Samples" />
        </TabItem.Header>
        <ListBox
          Name="SidebarSamples"
          ItemsSource="{DynamicResource Samples}"
          SelectionChanged="ListBox_SelectionChanged">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Value.Name}" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </TabItem>
      <TabItem Name="ExtensionTab">
        <TabItem.Header>
          <TextBlock FontSize="15" Text="Extensions" />
        </TabItem.Header>
        <ListBox
          Name="SidebarExtensions"
          ItemsSource="{DynamicResource Extensions}"
          SelectionChanged="ListBox_SelectionChanged">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Value.Name}" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </TabItem>
    </TabControl>
    <DockPanel Grid.Column="1" Margin="5,0,0,0">
      <ScrollViewer Name="DemoContent" />
    </DockPanel>
  </Grid>
</UserControl>
