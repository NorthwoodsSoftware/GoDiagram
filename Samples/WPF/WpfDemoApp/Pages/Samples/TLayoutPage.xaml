<demo:DemoControl
  x:Class="Demo.Samples.TLayout.TLayout"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:demo="clr-namespace:Demo"
  xmlns:go="clr-namespace:Northwoods.Go.Wpf;assembly=Northwoods.GoDiagram.Wpf"
  xmlns:views="clr-namespace:WpfDemoApp.Views"
  d:DesignHeight="450"
  d:DesignWidth="800"
  mc:Ignorable="d">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Orientation="Horizontal">
      <StackPanel>
        <TextBlock FontWeight="Bold">Tree Style</TextBlock>
        <ComboBox Name="style" />
        <TextBlock FontWeight="Bold">Layer Style</TextBlock>
        <ComboBox Name="layerStyle" />
        <TextBlock Margin="0,10,0,0" FontWeight="Bold">New Tree</TextBlock>
        <StackPanel Orientation="Horizontal">
          <TextBlock>MinNodes:</TextBlock>
          <demo:NumericUpDown
            x:Name="minNodes"
            Increment="1"
            Minimum="1"
            Value="20" />
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock>MaxNodes:</TextBlock>
          <demo:NumericUpDown
            x:Name="maxNodes"
            Increment="1"
            Minimum="1"
            Value="100" />
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock>MinChildren:</TextBlock>
          <demo:NumericUpDown
            x:Name="minChil"
            Increment="1"
            Minimum="0"
            Value="1" />
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock>MaxChildren:</TextBlock>
          <demo:NumericUpDown
            x:Name="maxChil"
            Increment="1"
            Minimum="0"
            Value="3" />
        </StackPanel>
        <CheckBox Name="randomSizes">Random sizes</CheckBox>
        <Button Name="generateBtn">Generate Tree</Button>
      </StackPanel>
      <StackPanel>
        <TextBlock FontWeight="Bold">Default Properties</TextBlock>
        <StackPanel Orientation="Horizontal">
          <TextBlock>Angle:</TextBlock>
          <RadioButton
            Name="right"
            GroupName="angle"
            IsChecked="True">
            Right
          </RadioButton>
          <RadioButton Name="down" GroupName="angle">Down</RadioButton>
          <RadioButton Name="left" GroupName="angle">Left</RadioButton>
          <RadioButton Name="up" GroupName="angle">Up</RadioButton>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock>Alignment:</TextBlock>
          <ComboBox Name="align" />
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock>NodeSpacing:</TextBlock>
          <demo:NumericUpDown
            x:Name="nodeSpacing"
            Increment="1"
            Value="20" />
          <TextBlock>(negative causes overlaps)</TextBlock>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock>NodeIndent:</TextBlock>
          <demo:NumericUpDown
            x:Name="nodeIndent"
            Increment="1"
            Minimum="0"
            Value="0" />
          <TextBlock>
            (when Start or End; >= 0)
          </TextBlock>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock>NodeIndentPastParent:</TextBlock>
          <demo:NumericUpDown
            x:Name="nodeIndentPastParent"
            Increment=".1"
            Maximum="1.0"
            Minimum="0.0"
            Value="0.0" />
          <TextBlock>(fraction; 0-1)</TextBlock>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock>LayerSpacing:</TextBlock>
          <demo:NumericUpDown
            x:Name="layerSpacing"
            Increment="1"
            Value="50" />
          <TextBlock>(negative causes overlaps)</TextBlock>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock>LayerSpacingParentOverlap:</TextBlock>
          <demo:NumericUpDown
            x:Name="layerSpacingParentOverlap"
            Increment=".1"
            Maximum="1.0"
            Minimum="0.0"
            Value="0.0" />
          <TextBlock>(fraction; 0-1)</TextBlock>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock>Sorting:</TextBlock>
          <ComboBox Name="sorting" />
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock>Compaction:</TextBlock>
          <RadioButton
            Name="block"
            GroupName="compaction"
            IsChecked="True">
            Block
          </RadioButton>
          <RadioButton Name="none" GroupName="compaction">None</RadioButton>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock>BreadthLimit:</TextBlock>
          <demo:NumericUpDown
            x:Name="breadthLimit"
            Increment="1"
            Value="0" />
          <TextBlock>(0 means no limit)</TextBlock>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock>RowSpacing:</TextBlock>
          <demo:NumericUpDown
            x:Name="rowSpacing"
            Increment="1"
            Value="25" />
          <TextBlock>(negative causes overlaps)</TextBlock>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock>RowIndent:</TextBlock>
          <demo:NumericUpDown
            x:Name="rowIndent"
            Increment="1"
            Minimum="0"
            Value="10" />
          <TextBlock>
            (>= 0)
          </TextBlock>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <CheckBox Name="setsPortSpot" IsChecked="True">SetsPortSpot</CheckBox>
          <CheckBox Name="setsChildPortSpot" IsChecked="True">SetsChildPortSpot</CheckBox>
        </StackPanel>
      </StackPanel>
      <StackPanel>
        <StackPanel>
          <TextBlock FontWeight="Bold">Alternates</TextBlock>
          <TextBlock>(only when TreeStyle is not Layered)</TextBlock>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock>Angle:</TextBlock>
          <RadioButton
            Name="altRight"
            GroupName="altAngle"
            IsChecked="True">
            Right
          </RadioButton>
          <RadioButton Name="altDown" GroupName="altAngle">Down</RadioButton>
          <RadioButton Name="altLeft" GroupName="altAngle">Left</RadioButton>
          <RadioButton Name="altUp" GroupName="altAngle">Up</RadioButton>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock>Alignment:</TextBlock>
          <ComboBox Name="altAlign" />
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock>NodeSpacing:</TextBlock>
          <demo:NumericUpDown
            x:Name="altNodeSpacing"
            Increment="1"
            Value="20" />
          <TextBlock>(negative causes overlaps)</TextBlock>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock>NodeIndent:</TextBlock>
          <demo:NumericUpDown
            x:Name="altNodeIndent"
            Increment="1"
            Minimum="0"
            Value="0" />
          <TextBlock>
            (when Start or End; >= 0)
          </TextBlock>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock>NodeIndentPastParent:</TextBlock>
          <demo:NumericUpDown
            x:Name="altNodeIndentPastParent"
            Increment=".1"
            Maximum="1.0"
            Minimum="0.0"
            Value="0.0" />
          <TextBlock>(fraction; 0-1)</TextBlock>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock>LayerSpacing:</TextBlock>
          <demo:NumericUpDown
            x:Name="altLayerSpacing"
            Increment="1"
            Value="50" />
          <TextBlock>(negative causes overlaps)</TextBlock>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock>LayerSpacingParentOverlap:</TextBlock>
          <demo:NumericUpDown
            x:Name="altLayerSpacingParentOverlap"
            Increment=".1"
            Maximum="1.0"
            Minimum="0.0"
            Value="0.0" />
          <TextBlock>(fraction; 0-1)</TextBlock>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock>Sorting:</TextBlock>
          <ComboBox Name="altSorting" />
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock>Compaction:</TextBlock>
          <RadioButton
            Name="altBlock"
            GroupName="altCompaction"
            IsChecked="True">
            Block
          </RadioButton>
          <RadioButton Name="altNone" GroupName="altCompaction">None</RadioButton>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock>BreadthLimit:</TextBlock>
          <demo:NumericUpDown
            x:Name="altBreadthLimit"
            Increment="1"
            Value="0" />
          <TextBlock>(0 means no limit)</TextBlock>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock>RowSpacing:</TextBlock>
          <demo:NumericUpDown
            x:Name="altRowSpacing"
            Increment="1"
            Value="25" />
          <TextBlock>(negative causes overlaps)</TextBlock>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock>RowIndent:</TextBlock>
          <demo:NumericUpDown
            x:Name="altRowIndent"
            Increment="1"
            Minimum="0"
            Value="10" />
          <TextBlock>
            (>= 0)
          </TextBlock>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <CheckBox Name="altSetsPortSpot" IsChecked="True">SetsPortSpot</CheckBox>
          <CheckBox Name="altSetsChildPortSpot" IsChecked="True">SetsChildPortSpot</CheckBox>
        </StackPanel>
      </StackPanel>
    </StackPanel>
    <go:DiagramControl
      x:Name="diagramControl1"
      Grid.Row="1"
      Height="500"
      BorderBrush="Black"
      BorderThickness="1" />
    <views:DescriptionView x:Name="desc1" Grid.Row="2" />
  </Grid>
</demo:DemoControl>
