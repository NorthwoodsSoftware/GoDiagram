<demo:DemoControl
  x:Class="Demo.Samples.UpdateDemo.UpdateDemo"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:demo="clr-namespace:Demo"
  xmlns:go="clr-namespace:Northwoods.Go.Wpf;assembly=Northwoods.GoDiagram.Wpf"
  xmlns:views="clr-namespace:WpfDemoApp.Views"
  d:DesignHeight="450"
  d:DesignWidth="800"
  mc:Ignorable="d">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="300" />
      <RowDefinition Height="300" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <go:DiagramControl
      x:Name="diagramControl1"
      Grid.Row="0"
      Grid.Column="0"
      BorderBrush="Blue"
      BorderThickness="1" />
    <StackPanel Grid.Row="0" Grid.Column="1">
      <Button Name="clearModelLogBtn">Clear Model Log</Button>
      <ListBox
        Name="modelLog"
        Height="250"
        ItemsSource="{Binding $parent[3].Log}" />
    </StackPanel>
    <go:DiagramControl
      x:Name="diagramControl2"
      Grid.Row="1"
      Grid.Column="0"
      BorderBrush="Green"
      BorderThickness="1" />
    <StackPanel Grid.Row="1" Grid.Column="1">
      <StackPanel Orientation="Horizontal">
        <Button Name="undoBtn">Undo</Button>
        <Button Name="redoBtn">Redo</Button>
      </StackPanel>
      <go:DiagramControl
        Name="diagramControl3"
        Height="250"
        BorderBrush="Black"
        BorderThickness="1" />
    </StackPanel>
    <views:DescriptionView
      x:Name="desc1"
      Grid.Row="2"
      Grid.ColumnSpan="2" />
  </Grid>
</demo:DemoControl>
