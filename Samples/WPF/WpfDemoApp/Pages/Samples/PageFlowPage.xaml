<demo:DemoControl
  x:Class="Demo.Samples.PageFlow.PageFlow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:demo="clr-namespace:Demo"
  xmlns:go="clr-namespace:Northwoods.Go.Wpf;assembly=Northwoods.GoDiagram.Wpf"
  xmlns:views="clr-namespace:WpfDemoApp.Views"
  d:DesignHeight="450"
  d:DesignWidth="800"
  mc:Ignorable="d">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="100" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="480" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <go:PaletteControl
      Name="paletteControl1"
      Grid.Column="0"
      Margin="0,0,2,0"
      Background="WhiteSmoke"
      BorderBrush="Black"
      BorderThickness="1" />
    <go:DiagramControl
      x:Name="diagramControl1"
      Grid.Column="1"
      BorderBrush="Black"
      BorderThickness="1" />
    <Button
      Name="layoutBtn"
      Grid.Row="1"
      Grid.ColumnSpan="2">
      Layout Diagram
    </Button>
    <views:DescriptionView
      x:Name="desc1"
      Grid.Row="2"
      Grid.ColumnSpan="2" />
    <views:ModelJsonView
      x:Name="modelJson1"
      Grid.Row="3"
      Grid.ColumnSpan="2" />
  </Grid>
</demo:DemoControl>
