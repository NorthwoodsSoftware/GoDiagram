<demo:DemoControl
  x:Class="Demo.Samples.OrgChartStatic.OrgChartStatic"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:demo="clr-namespace:Demo"
  xmlns:go="clr-namespace:Northwoods.Go.Wpf;assembly=Northwoods.GoDiagram.Wpf"
  xmlns:views="clr-namespace:WpfDemoApp.Views"
  d:DesignHeight="450"
  d:DesignWidth="800"
  mc:Ignorable="d">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <go:OverviewControl
      Name="overviewControl1"
      Grid.Row="0"
      Width="200"
      Height="100"
      Margin="10"
      HorizontalAlignment="Left"
      VerticalAlignment="Top"
      Panel.ZIndex="300"
      Background="#f2f2f2"
      BorderBrush="#7986cb"
      BorderThickness="1" />
    <go:DiagramControl
      x:Name="diagramControl1"
      Grid.Row="0"
      Height="700"
      Background="#f2f2f2"
      BorderBrush="Black"
      BorderThickness="1" />
    <StackPanel
      Grid.Row="1"
      Margin="0,3,0,0"
      Orientation="Horizontal">
      <TextBox Name="textBox1" Width="120" />
      <Button Name="searchBtn">Search</Button>
    </StackPanel>
    <views:DescriptionView x:Name="desc1" Grid.Row="2" />
  </Grid>
</demo:DemoControl>
