<demo:DemoControl
  x:Class="Demo.Samples.DynamicPorts.DynamicPorts"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:demo="clr-namespace:Demo"
  xmlns:go="clr-namespace:Northwoods.Go.Wpf;assembly=Northwoods.GoDiagram.Wpf"
  xmlns:views="clr-namespace:WpfDemoApp.Views"
  d:DesignHeight="450"
  d:DesignWidth="800"
  mc:Ignorable="d">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <go:DiagramControl
      x:Name="diagramControl1"
      Grid.Row="0"
      Height="500"
      BorderBrush="Black"
      BorderThickness="1" />
    <StackPanel Grid.Row="1" Orientation="Horizontal">
      <TextBlock VerticalAlignment="Center">Add port to selected nodes:</TextBlock>
      <Button Name="topBtn">Top</Button>
      <Button Name="bottomBtn">Bottom</Button>
      <Button Name="leftBtn">Left</Button>
      <Button Name="rightBtn">Right</Button>
    </StackPanel>
    <views:DescriptionView x:Name="desc1" Grid.Row="2" />
    <views:ModelJsonView x:Name="modelJson1" Grid.Row="3" />
  </Grid>
</demo:DemoControl>
