<demo:DemoControl
  x:Class="Demo.Samples.Navigation.Navigation"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:demo="clr-namespace:Demo"
  xmlns:go="clr-namespace:Northwoods.Go.Wpf;assembly=Northwoods.GoDiagram.Wpf"
  xmlns:views="clr-namespace:WpfDemoApp.Views"
  d:DesignHeight="450"
  d:DesignWidth="800"
  mc:Ignorable="d">
  <demo:DemoControl.Resources>
    <Style TargetType="Rectangle">
      <Setter Property="Margin" Value="5" />
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
    </Style>
    <Style TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </demo:DemoControl.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="220" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="750" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <go:DiagramControl
      x:Name="diagramControl1"
      Grid.Row="0"
      Grid.Column="0"
      BorderBrush="Black"
      BorderThickness="1" />
    <StackPanel
      Grid.Row="0"
      Grid.Column="1"
      Margin="5,0,0,0">
      <StackPanel>
        <TextBlock Margin="0,0,0,5" FontWeight="Bold">Related Parts Highlighted</TextBlock>
        <RadioButton
          Name="unhighlightAllRb"
          Margin="0,0,0,5"
          GroupName="relatedGroup">
          Unhighlight All
        </RadioButton>
        <RadioButton
          Name="linksIntoRb"
          Margin="0,0,0,5"
          GroupName="relatedGroup">
          Links Into
        </RadioButton>
        <RadioButton
          Name="linksOutOfRb"
          Margin="0,0,0,5"
          GroupName="relatedGroup">
          Links Out Of
        </RadioButton>
        <RadioButton
          Name="linksConnectedRb"
          Margin="0,0,0,5"
          GroupName="relatedGroup">
          Links Connected
        </RadioButton>
        <RadioButton
          Name="nodesIntoRb"
          Margin="0,0,0,5"
          GroupName="relatedGroup">
          Nodes Into
        </RadioButton>
        <RadioButton
          Name="nodesOutOfRb"
          Margin="0,0,0,5"
          GroupName="relatedGroup">
          Nodes Out Of
        </RadioButton>
        <RadioButton
          Name="nodesConnectedRb"
          Margin="0,0,0,5"
          GroupName="relatedGroup">
          Nodes Connected
        </RadioButton>
        <RadioButton
          Name="nodesReachableRb"
          Margin="0,0,0,5"
          GroupName="relatedGroup"
          IsChecked="True">
          Nodes Reachable
        </RadioButton>
        <RadioButton
          Name="containingGroupParentRb"
          Margin="0,0,0,5"
          GroupName="relatedGroup">
          Containing Group (Parent)
        </RadioButton>
        <RadioButton
          Name="containingGroupsAllRb"
          Margin="0,0,0,5"
          GroupName="relatedGroup">
          Containing Groups (All)
        </RadioButton>
        <RadioButton
          Name="memberNodesChildrenRb"
          Margin="0,0,0,5"
          GroupName="relatedGroup">
          Member Nodes (Children)
        </RadioButton>
        <RadioButton
          Name="memberNodesAllRb"
          Margin="0,0,0,5"
          GroupName="relatedGroup">
          Member Nodes (All)
        </RadioButton>
        <RadioButton
          Name="memberLinksChildrenRb"
          Margin="0,0,0,5"
          GroupName="relatedGroup">
          Member Links (Children)
        </RadioButton>
        <RadioButton
          Name="memberLinksAllRb"
          Margin="0,0,0,5"
          GroupName="relatedGroup">
          Member Links (All)
        </RadioButton>
      </StackPanel>
      <StackPanel>
        <TextBlock Margin="0,5,0,5" FontWeight="Bold">Relationship Colors</TextBlock>
        <Grid ColumnDefinitions="Auto,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
          <Rectangle
            Grid.Row="0"
            Grid.Column="0"
            Fill="Black" />
          <TextBlock Grid.Row="0" Grid.Column="1">Not related</TextBlock>
          <Rectangle
            Grid.Row="1"
            Grid.Column="0"
            Fill="Blue" />
          <TextBlock Grid.Row="1" Grid.Column="1">Directly related</TextBlock>
          <Rectangle
            Grid.Row="2"
            Grid.Column="0"
            Fill="Green" />
          <TextBlock Grid.Row="2" Grid.Column="1">2 relationships apart</TextBlock>
          <Rectangle
            Grid.Row="3"
            Grid.Column="0"
            Fill="Orange" />
          <TextBlock Grid.Row="3" Grid.Column="1">3 relationships apart</TextBlock>
          <Rectangle
            Grid.Row="4"
            Grid.Column="0"
            Fill="Red" />
          <TextBlock Grid.Row="4" Grid.Column="1">4 relationships apart</TextBlock>
          <Rectangle
            Grid.Row="5"
            Grid.Column="0"
            Fill="Purple" />
          <TextBlock Grid.Row="5" Grid.Column="1">Very indirectly related</TextBlock>
        </Grid>
      </StackPanel>
    </StackPanel>
    <views:DescriptionView
      x:Name="desc1"
      Grid.Row="1"
      Grid.ColumnSpan="2" />
  </Grid>
</demo:DemoControl>
