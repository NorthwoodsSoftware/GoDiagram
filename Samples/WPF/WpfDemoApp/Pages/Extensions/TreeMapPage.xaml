<demo:DemoControl
  x:Class="Demo.Extensions.TreeMap.TreeMap"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:demo="clr-namespace:Demo"
  xmlns:go="clr-namespace:Northwoods.Go.Wpf;assembly=Northwoods.GoDiagram.Wpf"
  xmlns:views="clr-namespace:WpfDemoApp.Views"
  d:DesignHeight="450"
  d:DesignWidth="800"
  mc:Ignorable="d">
  <demo:DemoControl.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style TargetType="StackPanel">
      <Setter Property="Margin" Value="0,5,0,0" />
    </Style>
  </demo:DemoControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0">
      <TextBlock FontWeight="Bold">New Tree</TextBlock>
      <StackPanel Orientation="Horizontal">
        <TextBlock>MinNodes:</TextBlock>
        <TextBox Name="minNodes">300</TextBox>
      </StackPanel>
      <StackPanel Orientation="Horizontal">
        <TextBlock>MaxNodes:</TextBlock>
        <TextBox Name="maxNodes">500</TextBox>
      </StackPanel>
      <StackPanel Orientation="Horizontal">
        <TextBlock>MinChildren:</TextBlock>
        <TextBox Name="minChildren">2</TextBox>
      </StackPanel>
      <StackPanel Orientation="Horizontal">
        <TextBlock>MaxChildren:</TextBlock>
        <TextBox Name="maxChildren">5</TextBox>
      </StackPanel>
      <Button Name="generateTreeBtn">Generate Tree</Button>
    </StackPanel>
    <go:DiagramControl
      x:Name="diagramControl1"
      Grid.Row="1"
      Height="500"
      BorderBrush="Black"
      BorderThickness="1" />
    <views:DescriptionView x:Name="desc1" Grid.Row="2" />
  </Grid>
</demo:DemoControl>
