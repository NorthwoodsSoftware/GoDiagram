<demo:DemoControl
  x:Class="Demo.Extensions.Packed.Packed"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:demo="clr-namespace:Demo"
  xmlns:go="clr-namespace:Northwoods.Go.Wpf;assembly=Northwoods.GoDiagram.Wpf"
  xmlns:views="clr-namespace:WpfDemoApp.Views"
  d:DesignHeight="450"
  d:DesignWidth="800"
  mc:Ignorable="d">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <WrapPanel>
      <StackPanel Margin="3">
        <TextBlock FontWeight="Bold">General Properties</TextBlock>
        <StackPanel Orientation="Horizontal">
          <TextBlock>PackShape:</TextBlock>
          <ComboBox Name="packShape" />
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock>PackMode:</TextBlock>
          <ComboBox Name="packMode" />
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock>Aspect ratio:</TextBlock>
          <demo:NumericUpDown
            x:Name="aspectRatio"
            Increment=".5"
            Minimum=".1"
            Value="1" />
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock>Layout width:</TextBlock>
          <demo:NumericUpDown
            x:Name="width"
            Increment="50"
            Maximum="1200"
            Minimum="1"
            Value="600" />
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock>Layout height:</TextBlock>
          <demo:NumericUpDown
            x:Name="height"
            Increment="50"
            Maximum="1200"
            Minimum="1"
            Value="600" />
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock>Spacing:</TextBlock>
          <demo:NumericUpDown
            x:Name="spacing"
            Increment="1"
            Maximum="100"
            Minimum="0"
            Value="0" />
        </StackPanel>
      </StackPanel>
      <StackPanel Margin="20,3">
        <TextBlock FontWeight="Bold">Node Sorting Properties</TextBlock>
        <StackPanel Orientation="Horizontal">
          <TextBlock>SortOrder:</TextBlock>
          <ComboBox Name="sortOrder" />
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock>SortMode:</TextBlock>
          <ComboBox Name="sortMode" />
        </StackPanel>
        <TextBlock FontWeight="Bold">Circle Packing</TextBlock>
        <CheckBox Name="hasCircularNodes">HasCircularNodes</CheckBox>
      </StackPanel>
      <StackPanel Margin="3">
        <TextBlock FontWeight="Bold">Node Generation</TextBlock>
        <StackPanel Orientation="Horizontal">
          <TextBlock># of nodes:</TextBlock>
          <demo:NumericUpDown
            x:Name="numNodes"
            Increment="1"
            Maximum="300"
            Minimum="1"
            Value="100" />
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock>Node shape:</TextBlock>
          <RadioButton
            Name="rectangleRb"
            GroupName="nodeShape"
            IsChecked="true">
            Rectangle
          </RadioButton>
          <RadioButton Name="ellipseRb" GroupName="nodeShape">Ellipse</RadioButton>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock>Min side length:</TextBlock>
          <demo:NumericUpDown
            x:Name="nodeMinSide"
            Increment="1"
            Maximum="100"
            Minimum="1"
            Value="30" />
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock>Max side length:</TextBlock>
          <demo:NumericUpDown
            x:Name="nodeMaxSide"
            Increment="1"
            Maximum="100"
            Minimum="1"
            Value="50" />
        </StackPanel>
        <CheckBox Name="sameSides">Same width/height</CheckBox>
        <Button Name="randomizeBtn">Randomize Graph</Button>
      </StackPanel>
    </WrapPanel>
    <go:DiagramControl
      x:Name="diagramControl1"
      Grid.Row="1"
      Height="500"
      BorderBrush="Black"
      BorderThickness="1" />
    <views:DescriptionView x:Name="desc1" Grid.Row="2" />
  </Grid>
</demo:DemoControl>
